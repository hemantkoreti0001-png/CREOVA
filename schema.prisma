generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  CREATOR
  BRAND
  ADMIN
  MODERATOR
}

enum ModerationStatus {
  QUEUED
  REVIEWING
  APPROVED
  REJECTED
  ESCALATED
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  displayName        String
  role               Role                @default(USER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  profile            UserProfile?
  posts              Post[]
  videos             Video[]
  tribeOwned         Tribe[]             @relation("TribeOwner")
  tribeMemberships   TribeMember[]
  likes              Like[]
  liveStreams        LiveStream[]
  memberships        Membership[]        @relation("Member")
  plans              MembershipPlan[]    @relation("CreatorPlans")
  tipsSent           Tip[]               @relation("TipSender")
  tipsReceived       Tip[]               @relation("TipReceiver")
  adEvents           AdEvent[]
  reports            Report[]
  moderationActions  ModerationAction[]
  copyrightClaims    CopyrightClaim[]
  messagesSent       Message[]            @relation("MessageSender")
  messagesReceived   Message[]            @relation("MessageReceiver")
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  bio         String?
  avatarUrl   String?
  coverUrl    String?
  websiteUrl  String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id          String   @id @default(cuid())
  userId      String
  title       String
  body        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes       Like[]
}

model Video {
  id             String            @id @default(cuid())
  userId         String
  title          String
  description    String?
  type           String            @default("long")
  videoUrl       String
  thumbnailUrl   String?
  views          Int               @default(0)
  likes          Int               @default(0)
  watchSeconds   Int               @default(0)
  moderationStatus ModerationStatus @default(QUEUED)
  createdAt      DateTime          @default(now())
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  likesRel       Like[]
  reports        Report[]
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  videoId   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
  @@unique([userId, videoId])
}

model Tribe {
  id          String        @id @default(cuid())
  ownerId     String
  name        String
  description String?
  createdAt   DateTime      @default(now())
  owner       User          @relation("TribeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     TribeMember[]
}

model TribeMember {
  id        String   @id @default(cuid())
  tribeId   String
  userId    String
  createdAt DateTime @default(now())
  tribe     Tribe    @relation(fields: [tribeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tribeId, userId])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  body       String
  createdAt  DateTime @default(now())
  sender     User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
}

model LiveStream {
  id           String   @id @default(cuid())
  hostId       String
  title        String
  description  String?
  status       String   @default("SCHEDULED")
  playbackUrl  String?
  viewerCount  Int      @default(0)
  peakViewers  Int      @default(0)
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime @default(now())
  host         User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
}

model MembershipPlan {
  id          String       @id @default(cuid())
  creatorId   String
  name        String
  description String?
  price       Decimal
  currency    String       @default("INR")
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  creator     User         @relation("CreatorPlans", fields: [creatorId], references: [id], onDelete: Cascade)
  members     Membership[]
}

model Membership {
  id        String          @id @default(cuid())
  planId    String
  memberId  String
  status    String          @default("ACTIVE")
  startedAt DateTime        @default(now())
  expiresAt DateTime?
  plan      MembershipPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  member    User            @relation("Member", fields: [memberId], references: [id], onDelete: Cascade)
  @@unique([planId, memberId])
}

model Tip {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  amount     Decimal
  currency   String   @default("INR")
  provider   String?
  externalRef String?
  message    String?
  createdAt  DateTime @default(now())
  sender     User     @relation("TipSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("TipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Advertisement {
  id          String     @id @default(cuid())
  title       String
  brandName   String
  creativeUrl String?
  targetUrl   String?
  budget      Decimal
  status      String     @default("DRAFT")
  createdAt   DateTime   @default(now())
  events      AdEvent[]
}

model AdEvent {
  id              String         @id @default(cuid())
  advertisementId String
  userId          String?
  eventType       String
  placement       String?
  metadata        Json?
  createdAt       DateTime       @default(now())
  advertisement   Advertisement  @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Report {
  id        String   @id @default(cuid())
  reporterId String
  videoId   String?
  reason    String
  details   String?
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  reporter  User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  video     Video?   @relation(fields: [videoId], references: [id], onDelete: SetNull)
}

model ModerationAction {
  id          String   @id @default(cuid())
  moderatorId String
  userId      String?
  action      String
  reason      String?
  createdAt   DateTime @default(now())
  moderator   User     @relation(fields: [moderatorId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model CopyrightClaim {
  id           String   @id @default(cuid())
  claimantId   String
  videoId      String?
  referenceUrl String?
  reason       String
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())
  claimant     User     @relation(fields: [claimantId], references: [id], onDelete: Cascade)
}
